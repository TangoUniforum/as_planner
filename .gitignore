# Greenfield forecast tool — code repo (separate from the shared Tool/
# as_forecast repo). Excludes the mutable workbook + transient artifacts.

# The I/O workbook: large binary, rewritten every run. Not tracked here;
# it's the shared data fixture in the parent folder.
Forecast.xlsm
*.xlsm

# Python bytecode
__pycache__/
*.pyc
*.pyo

# Editor / tooling
.claude/
.vscode/
.idea/

# Stable-config YAML, auto-seeded from the workbook by
# scripts/export_config_to_yaml.py (Phase 1 data-path inversion). Ignored
# for now because it's a derived artifact of the gitignored workbook;
# promote to tracked source-of-truth when config becomes app-authored.
config/

# Transient diagnostic outputs (scripts write these)
scripts/*_output.txt
scripts/_*.txt
*.tmp
_exp_*.xlsm
